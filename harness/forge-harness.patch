From bdc02dfc9abd8be9a2456ab10c02135916e53057 Mon Sep 17 00:00:00 2001
From: Larry Rennoldson <rennoldsonlarry@gmail.com>
Date: Fri, 11 Sep 2026 19:10:49 +0100
Subject: [PATCH 11/15] Harness: set up targets for chosen modes of triggered
 modal abilities

---
 .../java/forge/harness/RemoteController.java  | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/forge-harness/src/main/java/forge/harness/RemoteController.java b/forge-harness/src/main/java/forge/harness/RemoteController.java
index 5c41951f34..6c97cb9aa4 100644
--- a/forge-harness/src/main/java/forge/harness/RemoteController.java
+++ b/forge-harness/src/main/java/forge/harness/RemoteController.java
@@ -997,6 +997,31 @@ public final class RemoteController extends PlayerControllerAi {
                 chosen.add(possible.get(id));
             }
         }
+        // Triggered modal abilities need their chosen mode's targets set up here.
+        // The engine only calls SpellAbility.setupTargets() from PlaySpellAbility
+        // (spells/activated abilities), never from the trigger path, so a
+        // REMOTE-chosen modal trigger (e.g. Deceiver Exarch's "choose one — untap
+        // target permanent you control") would otherwise be added to the stack
+        // with no targets and silently dropped by MagicStack.add.  Cast/activated
+        // modal abilities are left untouched: their PlaySpellAbility path sets
+        // targets after mode selection.
+        if (sa.isTrigger()) {
+            Player activator = sa.getActivatingPlayer();
+            if (activator == null) {
+                activator = sa.getHostCard().getController();
+            }
+            for (AbilitySub sub : chosen) {
+                if (sub.usesTargeting()) {
+                    sub.setParent(sa);
+                    sub.setActivatingPlayer(activator);
+                    if (!sub.setupTargets()) {
+                        // No legal/valid target answer: the caller drops the
+                        // trigger deterministically (same NO-OP as a failed cast).
+                        return new ArrayList<>();
+                    }
+                }
+            }
+        }
         return chosen;
     }
 
