@@ -0,0 +1,40 @@
+package forge.harness;
+
+import io.grpc.Server;
+import io.grpc.ServerBuilder;
+import forge.gui.GuiBase;
+import forge.GuiDesktop;
+import forge.model.FModel;
+
+public final class HarnessMain {
+    private HarnessMain() {
+    }
+
+    public static void main(final String[] args) throws Exception {
+        int port = 50051;
+        for (int i = 0; i < args.length; i++) {
+            if ("--port".equals(args[i]) && i + 1 < args.length) {
+                port = Integer.parseInt(args[i + 1]);
+            }
+        }
+
+        // Forge's ExceptionHandler static-init installs a Sentry-based uncaught
+        // exception handler; override it with plain stderr logging.
+        Thread.setDefaultUncaughtExceptionHandler((t, ex) -> {
+            System.err.println("[harness] uncaught in " + t.getName() + ": " + ex);
+            ex.printStackTrace();
+        });
+        GuiBase.setInterface(new GuiDesktop());
+        System.out.println("[harness] initializing card database...");
+        FModel.initialize(null, null);
+        System.out.println("[harness] database ready, starting gRPC server on port " + port);
+
+        Server server = ServerBuilder.forPort(port)
+                .addService(new ForgeEnvService())
+                .build()
+                .start();
+        System.out.println("[harness] ready");
+        Runtime.getRuntime().addShutdownHook(new Thread(server::shutdownNow));
+        server.awaitTermination();
+    }
+}
