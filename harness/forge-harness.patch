+                    GameLogEntry e = entries.get(observedLogEntries++);
+                    if (isNondeterministicOutcomeEntry(e.type())) {
+                        // Engine match-tally narration ("X: 0 Y: 1", "A has
+                        // won because all opponents have lost") is built from
+                        // HashMap<RegisteredPlayer, ...> iteration (identity
+                        // hash codes), so which player gets credited is not
+                        // stable across runs — it broke byte-identical replay
+                        // on forced/drawn ends. The harness's own
+                        // Terminal-derived GameOver event (appended in
+                        // finish()) is the sole, deterministic game-over
+                        // event.
+                        continue;
+                    }
+                    batch.add(buildEvent(e));
+                }
+                eventBuffer.addAll(batch);
+            }
+        } catch (Exception e) {
+            // never let observation kill the game thread
+            e.printStackTrace();
         }
     }
+
+    /**
+     * GameLog entry types whose message text is derived from engine
+     * match/outcome state that is not seed-deterministic (hash-iteration
+     * order over RegisteredPlayer keys inside GameOutcome). They are excluded
+     * from the event buffer; GameOver events come from the runner's Terminal
+     * record instead.
+     */
+    private static boolean isNondeterministicOutcomeEntry(GameLogEntryType type) {
+        return type == GameLogEntryType.GAME_OUTCOME || type == GameLogEntryType.MATCH_RESULTS;
+    }
+
+    private GameEvent buildEvent(GameLogEntry e) {
+        int player = -1;
+        try {
+            Player acting = game.getPhaseHandler().getPlayerTurn();
+            if (acting != null) {
+                player = game.getPlayers().indexOf(acting);
+            }
+        } catch (Exception ignored) {
+        }
+        long seq = nextSeq++;
+        return GameEvent.newBuilder().setSeq(seq).setGameId(gameId)
+                .setTurn(getTurn()).setPhase(getPhase()).setPlayer(player)
+                .setType(mapEventType(e.type(), e.message()))
+                .setCardName(e.sourceCard() != null ? e.sourceCard().getName() : "")
+                .setDetail(e.message() == null ? "" : e.message())
+                .build();
+    }
+
+    /** Append a harness-generated event; caller holds {@link #lock}. */
+    private void appendEventLocked(String type, String cardName, String detail) {
+        long seq = nextSeq++;
+        eventBuffer.add(GameEvent.newBuilder().setSeq(seq).setGameId(gameId)
+                .setTurn(getTurn()).setPhase(getPhase()).setPlayer(-1)
+                .setType(type).setCardName(cardName).setDetail(detail).build());
+    }
+
+    /**
+     * Map a Forge GameLogEntryType onto the event vocabulary of the v2
+     * contract. Zone changes are disambiguated from the message text;
+     * anything unmapped keeps its enum name so no information is lost.
+     */
+    private static String mapEventType(GameLogEntryType type, String message) {
+        switch (type) {
+            case STACK_RESOLVE: return "SpellResolved";
+            case STACK_ADD: return "SpellCast";
+            case TURN: return "TurnStarted";
+            case PHASE: return "Phase";
+            case LIFE: return "LifeChanged";
+            case DAMAGE: return "Damage";
+            case GAME_OUTCOME: case MATCH_RESULTS:
+                // unreachable: filtered out in drainLogEntries; GameOver
+                // events are harness-generated from the Terminal record
+                return "GameOver";
+            case MULLIGAN: return "Mulligan";
+            case LAND: return "LandPlayed";
+            case DISCARD: return "Discard";
+            case COMBAT: return "Combat";
+            case PLAYER_CONTROL: return "PlayerControl";
+            case MANA: return "Mana";
+            case EFFECT_REPLACED: return "EffectReplaced";
+            case ZONE_CHANGE:
+                String m = message == null ? "" : message.toLowerCase();
+                if (m.contains("draw")) {
+                    return "CardDrawn";
+                }
+                if (m.contains("leaves") || m.contains("left") || m.contains("exile")
+                        || m.contains("graveyard")) {
+                    return "PermanentLeftBattlefield";
+                }
+                if (m.contains("enter")) {
+                    return "PermanentEntered";
+                }
+                return "ZoneChange";
+            default:
+                return type.toString();
+        }
+    }
+
+    /** Highest seq assigned so far (for SubmitDecision step-scoped event reads). */
+    public long currentSeq() {
+        synchronized (lock) {
+            return nextSeq - 1;
+        }
+    }
+
+    /** All buffered events with seq > cursor, in seq order. */
+    public List<GameEvent> pollEvents(long cursor) {
+        synchronized (lock) {
+            List<GameEvent> out = new ArrayList<>();
+            for (GameEvent e : eventBuffer) {
+                if (e.getSeq() > cursor) {
+                    out.add(e);
+                }
+            }
+            return out;
+        }
+    }
+
+    /** Last {@code n} buffered events (FullState.recent_events). */
+    public List<GameEvent> recentEvents(int n) {
+        synchronized (lock) {
+            int from = Math.max(0, eventBuffer.size() - n);
+            return new ArrayList<>(eventBuffer.subList(from, eventBuffer.size()));
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // Decision identity: register / peek / validate-and-take
+    // ------------------------------------------------------------------
+
+    /**
+     * Register a popped PendingDecision as the outstanding decision, assigning
+     * the next per-game decision_id and building the client-facing
+     * DecisionRequest. Returns the prebuilt request (or the existing one if a
+     * decision is already outstanding).
+     */
+    public DecisionRequest registerDecision(int playerIndex, RemoteController.PendingDecision pd) {
+        synchronized (lock) {
+            if (state == RunnerState.OVER || state == RunnerState.CLOSED) {
+                return null;
+            }
+            if (outstanding != null) {
+                return outstanding.request;
+            }
+            long decisionId = ++nextDecisionId;
+            DecisionRequest.Builder b = DecisionRequest.newBuilder()
+                    .setGameId(gameId)
+                    .setDecisionId(decisionId)
+                    .setPlayer(playerIndex)
+                    .setTurn(getTurn())
+                    .setPhase(getPhase())
+                    .setDecisionType("priority")
+                    .setPrompt(pd.getPrompt());
+            List<SpellAbility> abilities = pd.getAbilities();
+            for (int j = 0; j < abilities.size(); j++) {
+                SpellAbility sa = abilities.get(j);
+                b.addOptions(Option.newBuilder()
+                        .setId(j)
+                        .setKind(sa.isSpell() ? "play_card" : "activate")
+                        .setCardName(sa.getHostCard() != null ? sa.getHostCard().getName() : "")
+                        .setDescription(sa.toString()).build());
+            }
+            DecisionRequest request = b.build();
+            outstanding = new Outstanding(decisionId, playerIndex, abilities, request);
+            // Wake any GetDecision waiter blocked in awaitDecisionOrEnd.
+            lock.notifyAll();
+            return request;
+        }
+    }
+
+    /** The outstanding decision, if any (for idempotent GetDecision). */
+    public DecisionRequest peekOutstanding() {
+        synchronized (lock) {
+            return outstanding == null ? null : outstanding.request;
+        }
+    }
+
+    /**
+     * Validate a submit against the outstanding decision, take it (clearing
+     * the outstanding slot) and forward the choice to the remote controller.
+     * Throws INVALID_ARGUMENT on any mismatch.
+     */
+    public void submitDecision(long decisionId, int optionId) {
+        RemoteController rc;
+        synchronized (lock) {
+            if (outstanding == null) {
+                throw Status.INVALID_ARGUMENT.withDescription(
+                        "no decision outstanding for game_id " + gameId).asRuntimeException();
+            }
+            if (outstanding.decisionId != decisionId) {
+                throw Status.INVALID_ARGUMENT.withDescription("decision_id " + decisionId
+                        + " does not match outstanding decision_id " + outstanding.decisionId)
+                        .asRuntimeException();
+            }
+            if (optionId < 0 || optionId >= outstanding.abilities.size()) {
+                throw Status.INVALID_ARGUMENT.withDescription("option_id " + optionId
+                        + " is not among the " + outstanding.abilities.size()
+                        + " options of decision_id " + decisionId).asRuntimeException();
+            }
+            rc = remoteController(outstanding.playerIndex);
+            outstanding = null;
+        }
+        if (rc == null) {
+            throw Status.FAILED_PRECONDITION
+                    .withDescription("outstanding decision has no remote controller")
+                    .asRuntimeException();
+        }
+        rc.submitAnswer(optionId);
+    }
 }
