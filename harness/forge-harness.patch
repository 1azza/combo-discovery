diff --git a/forge-harness/src/main/java/forge/harness/ForgeEnvService.java b/forge-harness/src/main/java/forge/harness/ForgeEnvService.java
new file mode 100644
index 0000000000..c7b6b43f30
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/ForgeEnvService.java
@@ -0,0 +1,220 @@
+package forge.harness;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.zone.ZoneType;
+import forge.harness.proto.DecisionRequest;
+import forge.harness.proto.DecisionResponse;
+import forge.harness.proto.DeckSpec;
+import forge.harness.proto.Empty;
+import forge.harness.proto.ForgeEnvGrpc;
+import forge.harness.proto.FullState;
+import forge.harness.proto.GameEvent;
+import forge.harness.proto.GameOver;
+import forge.harness.proto.Option;
+import forge.harness.proto.Pong;
+import forge.harness.proto.StartRequest;
+import forge.harness.proto.StartResponse;
+import forge.harness.proto.StateToken;
+import forge.harness.proto.StepResult;
+import forge.harness.proto.Zone;
+import io.grpc.Status;
+import io.grpc.StatusRuntimeException;
+import io.grpc.stub.StreamObserver;
+
+public final class ForgeEnvService extends ForgeEnvGrpc.ForgeEnvImplBase {
+    static final String VERSION = "0.1.0";
+
+    private final AtomicReference<GameRunner> runner = new AtomicReference<>();
+
+    private GameRunner requireRunner() {
+        GameRunner r = runner.get();
+        if (r == null) {
+            throw Status.FAILED_PRECONDITION.withDescription("no active game; call StartGame first")
+                    .asRuntimeException();
+        }
+        return r;
+    }
+
+    @Override
+    public void ping(Empty request, StreamObserver<Pong> responseObserver) {
+        GameRunner r = runner.get();
+        responseObserver.onNext(Pong.newBuilder().setVersion(VERSION)
+                .setGameActive(r != null && !r.isGameOver()).build());
+        responseObserver.onCompleted();
+    }
+
+    @Override
+    public void startGame(StartRequest request, StreamObserver<StartResponse> responseObserver) {
+        GameRunner old = runner.get();
+        if (old != null) {
+            old.stop();
+        }
+        try {
+            List<forge.harness.DeckSpec> specs = new ArrayList<>();
+            for (int i = 0; i < request.getDecksCount(); i++) {
+                DeckSpec d = request.getDecks(i);
+                specs.add(new forge.harness.DeckSpec(d.getName(), d.getPath(),
+                        request.getPlayerTypesCount() > i ? request.getPlayerTypes(i).getNumber() : 1));
+            }
+            GameRunner r = new GameRunner(specs, request.getSeed());
+            runner.set(r);
+            r.start();
+            r.setTimeout(request.getTimeoutSeconds());
+            StartResponse.Builder resp = StartResponse.newBuilder().setGameId((int) request.getSeed());
+            for (Player p2 : r.game().getPlayers()) {
+                resp.addStartingLife(p2.getLife());
+            }
+            responseObserver.onNext(resp.build());
+            responseObserver.onCompleted();
+        } catch (IllegalArgumentException e) {
+            responseObserver.onError(Status.INVALID_ARGUMENT.withDescription(e.getMessage()).asException());
+        } catch (Exception e) {
+            responseObserver.onError(Status.INTERNAL.withDescription(String.valueOf(e)).asException());
+        }
+    }
+
+    @Override
+    public void getDecision(Empty request, StreamObserver<DecisionRequest> responseObserver) {
+        try {
+            GameRunner r = requireRunner();
+            long deadline = System.currentTimeMillis() + 130_000;
+            while (System.currentTimeMillis() < deadline && !r.isGameOver()) {
+                for (int i = 0; i < r.numPlayers(); i++) {
+                    RemoteController rc = r.remoteController(i);
+                    if (rc == null || rc.getMode() != RemoteController.Mode.REMOTE) {
+                        continue;
+                    }
+                    RemoteController.PendingDecision pd = rc.takePending(250);
+                    if (pd != null) {
+                        DecisionRequest.Builder b = DecisionRequest.newBuilder()
+                                .setPlayer(i)
+                                .setTurn(r.getTurn())
+                                .setPhase(r.getPhase())
+                                .setPrompt(pd.getPrompt());
+                        List<forge.game.spellability.SpellAbility> abilities = pd.getAbilities();
+                        for (int j = 0; j < abilities.size(); j++) {
+                            forge.game.spellability.SpellAbility sa = abilities.get(j);
+                            b.addOptions(Option.newBuilder()
+                                    .setId(j)
+                                    .setKind(sa.isSpell() ? "play_card" : "activate")
+                                    .setCardName(sa.getHostCard() != null ? sa.getHostCard().getName() : "")
+                                    .setDescription(sa.toString()).build());
+                        }
+                        responseObserver.onNext(b.build());
+                        responseObserver.onCompleted();
+                        return;
+                    }
+                }
+            }
+            responseObserver.onError(Status.DEADLINE_EXCEEDED
+                    .withDescription(r.isGameOver() ? "game over" : "no decision within timeout")
+                    .asException());
+        } catch (StatusRuntimeException e) {
+            responseObserver.onError(e);
+        } catch (Exception e) {
+            responseObserver.onError(Status.INTERNAL.withDescription(String.valueOf(e)).asException());
+        }
+    }
+
+    @Override
+    public void submitDecision(DecisionResponse request, StreamObserver<StepResult> responseObserver) {
+        try {
+            GameRunner r = requireRunner();
+            for (int i = 0; i < r.numPlayers(); i++) {
+                RemoteController rc = r.remoteController(i);
+                if (rc != null && rc.getMode() == RemoteController.Mode.REMOTE) {
+                    rc.submitAnswer(request.getOptionId());
+                    break;
+                }
+            }
+            List<GameEvent> evs = new ArrayList<>();
+            GameRunner.GameEventTuple e;
+            while ((e = r.pollEvent(50)) != null) {
+                evs.add(GameEvent.newBuilder().setType(e.type).setCardName(e.cardName)
+                        .setDetail(e.message).build());
+            }
+            responseObserver.onNext(StepResult.newBuilder()
+                    .addAllEvents(evs)
+                    .setDecisionPending(false)
+                    .setGameOver(r.isGameOver())
+                    .build());
+            responseObserver.onCompleted();
+        } catch (StatusRuntimeException e) {
+            responseObserver.onError(e);
+        } catch (Exception e) {
+            responseObserver.onError(Status.INTERNAL.withDescription(String.valueOf(e)).asException());
+        }
+    }
+
+    @Override
+    public void getState(Empty request, StreamObserver<FullState> responseObserver) {
+        try {
+            GameRunner r = requireRunner();
+            Game g = r.game();
+            FullState.Builder b = FullState.newBuilder()
+                    .setTurn(r.getTurn())
+                    .setPhase(r.getPhase());
+            forge.game.player.PlayerCollection players = g.getPlayers();
+            for (int i = 0; i < players.size(); i++) {
+                Player p = players.get(i);
+                b.addLife(p.getLife());
+                Zone.Builder hand = Zone.newBuilder();
+                for (Card c : p.getCardsIn(ZoneType.Hand)) {
+                    hand.addCards(forge.harness.proto.CardRef.newBuilder()
+                            .setName(c.getName()).setCount(1).build());
+                }
+                b.addHand(hand.build());
+                Zone.Builder field = Zone.newBuilder();
+                for (Card c : p.getCardsIn(ZoneType.Battlefield)) {
+                    field.addCards(forge.harness.proto.CardRef.newBuilder()
+                            .setName(c.getName()).setCount(1).build());
+                }
+                b.addBattlefield(field.build());
+            }
+            responseObserver.onNext(b.build());
+            responseObserver.onCompleted();
+        } catch (StatusRuntimeException e) {
+            responseObserver.onError(e);
+        } catch (Exception e) {
+            responseObserver.onError(Status.INTERNAL.withDescription(String.valueOf(e)).asException());
+        }
+    }
+
+    @Override
+    public void isGameOver(Empty request, StreamObserver<GameOver> responseObserver) {
+        try {
+            GameRunner r = requireRunner();
+            GameOver.Builder b = GameOver.newBuilder().setOver(r.isGameOver()).setWinner(r.getWinner());
+            responseObserver.onNext(b.build());
+            responseObserver.onCompleted();
+        } catch (StatusRuntimeException e) {
+            responseObserver.onError(e);
+        }
+    }
+
+    @Override
+    public void stopGame(Empty request, StreamObserver<Empty> responseObserver) {
+        GameRunner r = runner.getAndSet(null);
+        if (r != null) {
+            r.stop();
+        }
+        responseObserver.onNext(Empty.newBuilder().build());
+        responseObserver.onCompleted();
+    }
+
+    @Override
+    public void snapshot(Empty request, StreamObserver<StateToken> responseObserver) {
+        responseObserver.onError(Status.UNIMPLEMENTED.withDescription("snapshots arrive in M2").asException());
+    }
+
+    @Override
+    public void restore(StateToken request, StreamObserver<Empty> responseObserver) {
+        responseObserver.onError(Status.UNIMPLEMENTED.withDescription("snapshots arrive in M2").asException());
+    }
+}
diff --git a/forge-harness/src/main/java/forge/harness/GameRunner.java b/forge-harness/src/main/java/forge/harness/GameRunner.java
new file mode 100644
index 0000000000..4cf53da07b
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/GameRunner.java
@@ -0,0 +1,205 @@
+package forge.harness;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Observable;
+import java.util.Observer;
+import java.util.Random;
+import java.util.concurrent.BlockingQueue;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+
+import forge.LobbyPlayer;
+import forge.util.MyRandom;
+import forge.deck.Deck;
+import forge.deck.io.DeckSerializer;
+import forge.game.Game;
+import forge.game.GameEndReason;
+import forge.game.GameLogEntry;
+import forge.game.GameRules;
+import forge.game.GameType;
+import forge.game.Match;
+import forge.game.player.Player;
+import forge.game.player.RegisteredPlayer;
+
+/** Per-player deck + controller type for starting a harness game. */
+record DeckSpec(String name, String path, int playerType) {
+}
+
+/** Runs one game on a background thread and exposes observation + decision channels. */
+public final class GameRunner {
+    public final long seed;
+    public final Match match;
+    public final List<LobbyPlayer> lobbyPlayers = new ArrayList<>();
+
+    private final BlockingQueue<GameEventTuple> events = new LinkedBlockingQueue<>();
+    private int observedLogEntries;
+    private Game game;
+    private Thread gameThread;
+    private volatile boolean stopped;
+    private ScheduledFuture<?> timeoutHandle;
+    private static final ScheduledThreadPoolExecutor TIMEOUT_POOL = new ScheduledThreadPoolExecutor(2, r -> {
+        Thread t = new Thread(r, "harness-timeout");
+        t.setDaemon(true);
+        return t;
+    });
+
+    public Game game() {
+        return game;
+    }
+
+    public static final class GameEventTuple {
+        public final String type;
+        public final String message;
+        public final String cardName;
+
+        GameEventTuple(String t, String m, String c) {
+            type = t;
+            message = m;
+            cardName = c;
+        }
+    }
+
+    public GameRunner(List<DeckSpec> decks, long seed0) {
+        seed = seed0;
+        MyRandom.setRandom(new Random(seed));
+
+        GameType type = GameType.Constructed;
+        GameRules rules = new GameRules(type);
+        rules.setAppliedVariants(java.util.EnumSet.of(type));
+
+        List<RegisteredPlayer> players = new ArrayList<>();
+        for (int i = 0; i < decks.size(); i++) {
+            DeckSpec spec = decks.get(i);
+            Deck d = loadDeck(spec.path());
+            LobbyPlayer lp;
+            switch (spec.playerType()) {
+                case 3:
+                    lp = new forge.ai.LobbyPlayerAi(spec.name(),
+                            java.util.Collections.singleton(forge.ai.AIOption.USE_HYBRID_SIMULATION));
+                    break;
+                case 2:
+                    lp = new LobbyPlayerRemote(spec.name(), RemoteController.Mode.GOLDFISH);
+                    break;
+                case 1:
+                default:
+                    lp = new LobbyPlayerRemote(spec.name(), RemoteController.Mode.REMOTE);
+                    break;
+            }
+            lobbyPlayers.add(lp);
+            RegisteredPlayer rp = new RegisteredPlayer(d);
+            rp.setPlayer(lp);
+            players.add(rp);
+        }
+
+        match = new Match(rules, players, "Harness");
+    }
+
+    private static Deck loadDeck(String path) {
+        File f = new File(path);
+        if (!f.exists()) {
+            throw new IllegalArgumentException("deck file not found: " + path);
+        }
+        Deck d = DeckSerializer.fromFile(f);
+        if (d == null) {
+            throw new IllegalArgumentException("could not parse deck: " + path);
+        }
+        return d;
+    }
+
+    public void start() {
+        game = match.createGame();
+        game.getGameLog().addObserver(new Observer() {
+            @Override
+            public void update(Observable o, Object arg) {
+                List<GameLogEntry> entries = game.getGameLog().getAllEntries();
+                while (observedLogEntries < entries.size()) {
+                    GameLogEntry e = entries.get(observedLogEntries++);
+                    events.add(new GameEventTuple(e.type().toString(), e.message(),
+                            e.sourceCard() != null ? e.sourceCard().getName() : ""));
+                }
+            }
+        });
+        gameThread = new Thread(() -> {
+            try {
+                match.startGame(game);
+            } catch (Throwable e) {
+                e.printStackTrace();
+                events.add(new GameEventTuple("HarnessError", String.valueOf(e), ""));
+            }
+        }, "harness-game");
+        gameThread.setDaemon(true);
+        gameThread.start();
+    }
+
+    public void setTimeout(int seconds) {
+        if (seconds > 0) {
+            timeoutHandle = TIMEOUT_POOL.schedule(this::stop, seconds, java.util.concurrent.TimeUnit.SECONDS);
+        }
+    }
+
+    public GameEventTuple pollEvent(long timeoutMs) throws InterruptedException {
+        return events.poll(timeoutMs, TimeUnit.MILLISECONDS);
+    }
+
+    public boolean isGameOver() {
+        return game != null && (stopped || game.isGameOver() || !gameThread.isAlive());
+    }
+
+    public int getWinner() {
+        if (game == null || game.getOutcome() == null) {
+            return -1;
+        }
+        if (game.getOutcome() == null || game.getOutcome().isDraw()
+                || game.getOutcome().getWinningLobbyPlayer() == null) {
+            return -1;
+        }
+        LobbyPlayer w = game.getOutcome().getWinningLobbyPlayer();
+        return lobbyPlayers.indexOf(w);
+    }
+
+    public int getTurn() {
+        return game == null ? 0 : game.getPhaseHandler().getTurn();
+    }
+
+    public String getPhase() {
+        return game == null ? "" : game.getPhaseHandler().getPhase().name();
+    }
+
+    public RemoteController remoteController(int playerIdx) {
+        if (game == null) {
+            return null;
+        }
+        Player p = game.getPlayers().get(playerIdx);
+        if (p != null && p.getController() instanceof RemoteController) {
+            return (RemoteController) p.getController();
+        }
+        return null;
+    }
+
+    public int numPlayers() {
+        return game == null ? 0 : game.getPlayers().size();
+    }
+
+    public void stop() {
+        stopped = true;
+        if (game != null && !game.isGameOver()) {
+            try {
+                game.setGameOver(GameEndReason.Draw);
+            } catch (Exception ignored) {
+            }
+        }
+        for (int i = 0; i < numPlayers(); i++) {
+            RemoteController rc = remoteController(i);
+            if (rc != null) {
+                rc.abortWait();
+            }
+        }
+        if (gameThread != null) {
+            gameThread.interrupt();
+        }
+    }
+}
