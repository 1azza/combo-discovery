+
+import forge.harness.proto.GameEvent;
+import io.grpc.Status;
+import io.grpc.StatusRuntimeException;
+
+/**
+ * Seam-level tests for the pure-logic pieces of {@link GameRunner}: snapshot
+ * token formatting/parsing, the state-hash event projection, SHA-256, and the
+ * stale-decision prefix on the no-outstanding-decision submit path. No live
+ * engine is needed for these.
+ */
+class GameRunnerSeamsTest {
+
+    private static GameEvent event(String type, String cardName, String detail) {
+        return GameEvent.newBuilder()
+                .setType(type).setTurn(1).setPhase("MAIN1").setPlayer(0)
+                .setCardName(cardName).setDetailRaw(detail).build();
+    }
+
+    // ---- token format / parse --------------------------------------------
+
+    @Test
+    void tokenRoundTrip() {
+        assertEquals("7:3", GameRunner.tokenFor(7L, 3L));
+        assertEquals(3L, GameRunner.parseToken("7:3", 7L));
+        assertEquals(0L, GameRunner.parseToken("7:0", 7L));
+    }
+
+    @Test
+    void foreignTokenRejectedWithStalePrefix() {
+        StatusRuntimeException e =
+                assertThrows(StatusRuntimeException.class, () -> GameRunner.parseToken("7:3", 8L));
+        assertEquals(Status.Code.INVALID_ARGUMENT, e.getStatus().getCode());
+        assertTrue(e.getStatus().getDescription().startsWith("stale decision:"),
+                e.getStatus().getDescription());
+    }
+
+    @Test
+    void malformedTokensRejectedWithStalePrefix() {
+        for (String bad : new String[] { null, "", "abc", ":3", "7:", "7:notanumber" }) {
+            StatusRuntimeException e =
+                    assertThrows(StatusRuntimeException.class, () -> GameRunner.parseToken(bad, 7L));
+            assertTrue(e.getStatus().getDescription().startsWith("stale decision:"),
+                    "token=" + bad + " -> " + e.getStatus().getDescription());
+        }
+    }
+
+    // ---- sha256 -----------------------------------------------------------
+
+    @Test
+    void sha256KnownVector() {
+        assertEquals("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+                GameRunner.sha256Hex(""));
+        assertEquals(64, GameRunner.sha256Hex("abc").length());
+    }
+
+    // ---- event projection -------------------------------------------------
+
+    @Test
+    void eventProjectionIsStableAndMarkerInsensitive() {
+        List<GameEvent> events = List.of(
+                event("Phase", "", "A's Main phase"),
+                event("SpellCast", "Grizzly Bears", "A cast Grizzly Bears"),
+                event("PermanentEntered", "Grizzly Bears", "from=Stack;to=Battlefield"));
+        String p1 = GameRunner.eventProjection(events);
+        String p2 = GameRunner.eventProjection(List.copyOf(events));
+        assertEquals(p1, p2);
+
+        List<GameEvent> withMarker = new ArrayList<>(events);
+        withMarker.add(event(GameRunner.SNAPSHOT_MARKER_TYPE, "", "token=1"));
+        assertEquals(p1, GameRunner.eventProjection(withMarker),
+                "the SnapshotRestored marker must not shift the projection window");
+
+        // a real event after the marker does change the projection
+        withMarker.add(event("LifeChanged", "", "old=20;new=18"));
+        assertNotEquals(p1, GameRunner.eventProjection(withMarker));
+    }
+
+    @Test
+    void eventProjectionKeepsOnlyLast32NonMarkerEvents() {
+        List<GameEvent> events = new ArrayList<>();
+        for (int i = 0; i < 40; i++) {
