+        assertWrongArm(pd, "damage");
+    }
+
+    // ---- ORDER_BLOCKERS ---------------------------------------------------
+
+    @Test
+    void orderBlockersRequiresPermutationAndRejectsWrongArm() {
+        PendingDecision pd = PendingDecision.orderBlockers(List.of(), "order");
+        assertEquals(List.of(), validate(pd, base()
+                .setCardIds(IntList.getDefaultInstance()).build()));
+        assertPlainInvalid(rejects(pd, base()
+                .setCardIds(IntList.newBuilder().addValues(0).build()).build()));
+        assertWrongArm(pd, "card_ids");
+    }
+
+    // ---- CHOOSE_CARDS -----------------------------------------------------
+
+    @Test
