+import io.grpc.StatusRuntimeException;
+
+/**
+ * Conformance table for {@link GameRunner#validateAnswer}: valid answers are
+ * accepted, wrong oneof arms / out-of-range values / duplicates are rejected
+ * with INVALID_ARGUMENT, and a rejection never carries the stale-decision
+ * prefix.
+ *
+ * <p>Only validation paths that need no live engine objects are exercised with
+ * a "valid" answer here. Types whose accepted answer must resolve to real
+ * {@code Card}/{@code Player} engine objects (PRIORITY valid option,
+ * DECLARE_ATTACKERS/BLOCKERS with real cards, ASSIGN_COMBAT_DAMAGE to a real
+ * target, CHOOSE_TARGETS real candidates) are covered on their rejection paths
+ * only; the Python live suite covers their accepted paths.
+ */
+class DecisionValidationTest {
+
+    private static Object validate(PendingDecision pd, DecisionSubmit submit) {
+        return GameRunner.validateAnswer(pd, submit, null);
+    }
+
+    private static DecisionSubmit.Builder base() {
+        return DecisionSubmit.newBuilder().setGameId(1L).setDecisionId(1L);
+    }
+
+    private static StatusRuntimeException rejects(PendingDecision pd, DecisionSubmit submit) {
+        return assertThrows(StatusRuntimeException.class, () -> validate(pd, submit));
+    }
+
+    private static void assertPlainInvalid(StatusRuntimeException e) {
+        assertEquals(io.grpc.Status.Code.INVALID_ARGUMENT, e.getStatus().getCode());
+        String d = e.getStatus().getDescription();
+        assertFalse(d.startsWith("stale decision:"),
+                "validation failure must not be a stale-decision error: " + d);
+    }
+
+    private static void assertWrongArm(PendingDecision pd, String expectedArm) {
+        assertWrongArmMsg(pd, base().setOptionId(0).build(), expectedArm);
+    }
+
+    private static void assertWrongArmMsg(PendingDecision pd, DecisionSubmit wrong, String expectedArm) {
+        StatusRuntimeException e = rejects(pd, wrong);
+        assertPlainInvalid(e);
+        assertTrue(e.getStatus().getDescription().contains("must use " + expectedArm),
+                e.getStatus().getDescription());
+    }
+
+    // ---- PRIORITY ---------------------------------------------------------
+
+    @Test
+    void priorityRejectsOutOfRangeAndWrongArm() {
+        PendingDecision pd = PendingDecision.priority(List.of(), "priority");
+        assertPlainInvalid(rejects(pd, base().setOptionId(0).build()));
+        assertPlainInvalid(rejects(pd, base().setOptionId(-1).build()));
+        assertWrongArmMsg(pd, base().setBooleanAnswer(true).build(), "option_id");
+    }
+
+    // ---- MULLIGAN_KEEP ----------------------------------------------------
+
+    @Test
+    void mulliganKeepAcceptsBooleanAndRejectsWrongArm() {
+        PendingDecision pd = PendingDecision.mulliganKeep(List.of(), 0, "keep?");
+        assertEquals(Boolean.TRUE, validate(pd, base().setBooleanAnswer(true).build()));
+        assertEquals(Boolean.FALSE, validate(pd, base().setBooleanAnswer(false).build()));
+        assertWrongArm(pd, "boolean_answer");
+    }
+
+    // ---- MULLIGAN_TUCK ----------------------------------------------------
+
+    @Test
+    void mulliganTuckRequiresExactCountAndRejectsWrongArm() {
+        PendingDecision pd = PendingDecision.mulliganTuck(List.of(), 0, "tuck");
+        assertEquals(List.of(), validate(pd, base()
+                .setCardIds(IntList.getDefaultInstance()).build()));
+        assertPlainInvalid(rejects(pd, base()
+                .setCardIds(IntList.newBuilder().addValues(0).build()).build()));
+        assertWrongArm(pd, "card_ids");
+    }
+
+    // ---- DECLARE_ATTACKERS ------------------------------------------------
+
+    @Test
+    void declareAttackersAcceptsEmptyAndRejectsWrongArm() {
+        PendingDecision pd = PendingDecision.declareAttackers(List.of(), List.of(), "attack");
+        assertEquals(List.of(), validate(pd, base()
+                .setAttackers(forge.harness.proto.AttackerList.getDefaultInstance()).build()));
+        assertWrongArm(pd, "attackers");
+    }
+
+    // ---- DECLARE_BLOCKERS -------------------------------------------------
+
+    @Test
