+        PendingDecision required = PendingDecision.chooseCards(List.of(), 1, 1, false, "choose");
+        assertPlainInvalid(rejects(required, base()
+                .setCardIds(IntList.getDefaultInstance()).build()));
+        assertPlainInvalid(rejects(required, base()
+                .setCardIds(IntList.newBuilder().addValues(0).build()).build()));
+        assertWrongArm(required, "card_ids");
+    }
+
+    // ---- ANNOUNCE ---------------------------------------------------------
+
+    @Test
+    void announceRangeAndWrongArm() {
+        PendingDecision pd = PendingDecision.announce(2, 5, "announce");
+        assertEquals(3, ((Number) validate(pd, base().setNumberAnswer(3).build())).intValue());
+        assertPlainInvalid(rejects(pd, base().setNumberAnswer(1).build()));
+        assertPlainInvalid(rejects(pd, base().setNumberAnswer(6).build()));
+        assertWrongArm(pd, "number_answer");
+    }
+
+    // ---- SCRY_ARRANGE -----------------------------------------------------
+
+    @Test
+    void scryArrangeRequiresFullPartitionAndWrongArm() {
+        PendingDecision pd = PendingDecision.scryArrange(List.of(), "scry");
+        assertInstanceOf(PendingDecision.Partition.class, validate(pd, base()
+                .setScry(forge.harness.proto.CardPartition.getDefaultInstance()).build()));
+        assertPlainInvalid(rejects(pd, base()
+                .setScry(forge.harness.proto.CardPartition.newBuilder().addTop(0).build()).build()));
+        assertWrongArm(pd, "scry");
+    }
+
+    // ---- CHOOSE_TARGETS ---------------------------------------------------
+
+    @Test
+    void chooseTargetsCountMandatoryOutOfRangeAndWrongArm() {
+        PendingDecision pd = PendingDecision.chooseTargets(List.of(), List.of(), 0, 0, false, "d", "targets");
+        assertEquals(List.of(), validate(pd, base()
+                .setTargets(TargetSelection.getDefaultInstance()).build()));
+        assertPlainInvalid(rejects(pd, base().setTargets(TargetSelection.newBuilder()
+                .addCardIds(0).build()).build()));
+        assertPlainInvalid(rejects(pd, base().setTargets(TargetSelection.newBuilder()
+                .addPlayerSlots(0).build()).build()));
+        assertPlainInvalid(rejects(pd, base().setTargets(TargetSelection.newBuilder()
+                .addCardIds(0).addCardIds(1).build()).build()));
+        assertWrongArm(pd, "targets");
+
+        PendingDecision mandatory = PendingDecision.chooseTargets(List.of(), List.of(), 1, 1, true, "d", "t");
