 import forge.util.ITriggerEvent;
 import forge.game.zone.ZoneType;
@@ -956,6 +962,148 @@ public final class RemoteController extends PlayerControllerAi {
         return true;
     }
 
+    /**
+     * Binary choice (TapOrUntap etc.). The inherited AI hardcodes
+     * {@code TapOrUntap -> true} (tap), which silently breaks any loop that
+     * needs the untap half (e.g. Pestermite). Surface it as a two-option
+     * CHOOSE_MODE so the remote policy decides; mode id 0 = Tap, 1 = Untap.
+     * Every other binary kind keeps the inherited behaviour.
+     */
+    @Override
+    public boolean chooseBinary(SpellAbility sa, String question,
+            BinaryChoiceType kindOfChoice, Boolean defaultVal) {
+        if (mode == Mode.GOLDFISH || kindOfChoice != BinaryChoiceType.TapOrUntap) {
+            return super.chooseBinary(sa, question, kindOfChoice, defaultVal);
+        }
+        Object ans = awaitAnswer(PendingDecision.chooseMode(spellDescription(sa),
+                Arrays.asList("Tap", "Untap"), 1, 1, false,
+                question + " (tap or untap)"));
+        if (ans instanceof List && !((List<?>) ans).isEmpty()) {
+            Object first = ((List<?>) ans).get(0);
+            if (first instanceof Number) {
+                int id = ((Number) first).intValue();
+                if (id == 0) {
+                    return true;   // Tap
+                }
+                if (id == 1) {
+                    return false;  // Untap
+                }
+            }
+        }
+        // ABORTED / TIMED_OUT / malformed: the engine's own default choice.
+        return super.chooseBinary(sa, question, kindOfChoice, defaultVal);
+    }
+
+    /**
+     * Remote trigger play. The inherited path routes non-modal triggered
+     * abilities through {@code brains.doTrigger}, which chooses their targets
+     * with the AI heuristic and never consults the remote controller (Zealous
+     * Conscripts' ETB would gain control of its own token instead of the
+     * engine card). Modal triggers (Charm) already route mode + targets
+     * through {@link #chooseModeForAbility}, so they keep the inherited path.
+     *
+     * <p>For every other targeting trigger the targets are surfaced as a
+     * CHOOSE_TARGETS decision via {@link #chooseTargetsFor} and the trigger is
+     * then played. This deliberately lets the remote policy take its own
+     * triggers, which is the behaviour a combo verifier needs.
+     */
+    @Override
+    public boolean playTrigger(Card host, WrappedAbility wrapperAbility, boolean isMandatory) {
+        if (mode == Mode.GOLDFISH) {
+            return super.playTrigger(host, wrapperAbility, isMandatory);
+        }
+        if (!prepareRemoteTrigger(host, wrapperAbility, isMandatory)) {
+            return false;
+        }
+        return ComputerUtil.playNoStack(wrapperAbility.getActivatingPlayer(), wrapperAbility,
+                getGame(), true);
+    }
+
+    /**
+     * Optional-trigger confirmation. The inherited AI decides whether to take
+     * a "you may" trigger; for a remote player the witness policy should take
+     * its own loop-closing triggers (there is no CONFIRM decision type in v7).
+     * The effect's own choices (targets / tap-untap) are still surfaced.
+     */
+    @Override
+    public boolean confirmTrigger(WrappedAbility wrapper) {
+        if (mode == Mode.GOLDFISH) {
+            return super.confirmTrigger(wrapper);
+        }
+        return true;
+    }
+
+    /**
+     * Simultaneous trigger batch (the ETB path). The inherited implementation
+     * calls the private {@code prepareSingleSa}, which routes non-modal
+     * triggers through {@code brains.doTrigger} and lets the AI pick their
+     * targets. Re-route every remote trigger through
+     * {@link #prepareRemoteTrigger} so targeting surfaces as CHOOSE_TARGETS.
+     * Non-trigger entries keep the inherited stack handling.
+     */
+    @Override
+    public void orderAndPlaySimultaneousSa(List<SpellAbility> activePlayerSAs) {
+        if (mode == Mode.GOLDFISH) {
+            super.orderAndPlaySimultaneousSa(activePlayerSAs);
+            return;
+        }
+        for (final SpellAbility sa : orderSimultaneousSa(activePlayerSAs)) {
+            if (sa.isTrigger() && !sa.isCopied()) {
+                if (prepareRemoteTrigger(sa.getHostCard(), sa, true)) {
+                    ComputerUtil.playStack(sa, player, getGame());
+                }
+            } else {
+                super.orderAndPlaySimultaneousSa(Collections.singletonList(sa));
+            }
+        }
+    }
+
+    /**
+     * Prepare one remote trigger for the stack. Mirrors the inherited private
+     * {@code prepareSingleSa}: Charm triggers route mode + targets through
+     * {@link #chooseModeForAbility}, and {@code TargetingPlayer} redirects.
+     * For every other trigger whose ability chain uses targeting, targets are
+     * surfaced through this controller via {@code setupTargets()} (which calls
+     * {@link #chooseTargetsFor}) instead of the AI heuristic. A trigger with
+     * no targeting keeps the inherited {@code doTrigger} decision.
+     */
+    private boolean prepareRemoteTrigger(Card host, SpellAbility sa, boolean isMandatory) {
+        SpellAbility ability = sa;
+        if (ability.getApi() == ApiType.Charm) {
+            if (!CharmEffect.makeChoices(ability)) {
+                return false;
+            }
+            if (!ability.hasParam("Random")) {
+                return true;
+            }
+            ability = ability.getSubAbility();
+            if (ability == null) {
+                return true;
+            }
+        }
+        if (ability.hasParam("TargetingPlayer")) {
+            Player targetingPlayer = AbilityUtils.getDefinedPlayers(host,
+                    ability.getParam("TargetingPlayer"), ability).get(0);
+            ability.setTargetingPlayer(targetingPlayer);
+            return targetingPlayer.getController().chooseTargetsFor(ability);
+        }
+        Player activator = ability.getActivatingPlayer();
+        if (activator == null) {
+            activator = host.getController();
+        }
+        boolean targeting = false;
+        for (SpellAbility cur = ability; cur != null; cur = cur.getSubAbility()) {
+            cur.setActivatingPlayer(activator);
+            if (cur.usesTargeting()) {
+                targeting = true;
+            }
+        }
+        if (!targeting) {
+            return getAi().doTrigger(ability, isMandatory);
+        }
+        return ability.setupTargets();
+    }
+
     /**
      * v4 CHOOSE_MODE. Answer = mode ids via the card_ids arm, in chosen order.
      * ABORTED returns the first {@code min} modes (deterministic NO-OP);
