diff --git a/forge-harness/src/main/java/forge/harness/RemoteController.java b/forge-harness/src/main/java/forge/harness/RemoteController.java
new file mode 100644
index 0000000000..4f680721c9
--- /dev/null
+++ b/forge-harness/src/main/java/forge/harness/RemoteController.java
@@ -0,0 +1,128 @@
+package forge.harness;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.BlockingQueue;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+
+import forge.ai.AiPlayDecision;
+import forge.ai.ComputerUtilAbility;
+import forge.ai.PlayerControllerAi;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.util.ITriggerEvent;
+import forge.game.zone.ZoneType;
+import forge.LobbyPlayer;
+
+/**
+ * PlayerControllerAi subclass that surfaces the priority decision to the gRPC
+ * client (REMOTE) or plays a strict goldfish game (GOLDFISH: never casts,
+ * never attacks, keeps AI defaults for mandatory choices).
+ */
+public final class RemoteController extends PlayerControllerAi {
+    public enum Mode { REMOTE, GOLDFISH }
+
+    /** One surfaced decision awaiting the client. */
+    public static final class PendingDecision {
+        private final List<SpellAbility> abilities;
+        private final String prompt;
+
+        public PendingDecision(List<SpellAbility> abilities0, String prompt0) {
+            abilities = abilities0;
+            prompt = prompt0;
+        }
+
+        public List<SpellAbility> getAbilities() {
+            return abilities;
+        }
+
+        public String getPrompt() {
+            return prompt;
+        }
+    }
+
+    private static final long DECISION_TIMEOUT_MS = 120_000;
+
+    private final Mode mode;
+    private final BlockingQueue<PendingDecision> pending = new LinkedBlockingQueue<>();
+    private volatile CompletableFuture<Integer> answer;
+
+    public RemoteController(Game game, Player p, LobbyPlayer lp, Mode mode0) {
+        super(game, p, lp);
+        mode = mode0;
+    }
+
+    public Mode getMode() {
+        return mode;
+    }
+
+    public PendingDecision takePending(long timeoutMs) throws InterruptedException {
+        return pending.poll(timeoutMs, TimeUnit.MILLISECONDS);
+    }
+
+    public void submitAnswer(int index) {
+        CompletableFuture<Integer> a = answer;
+        if (a != null) {
+            a.complete(index);
+        }
+    }
+
+    public void abortWait() {
+        CompletableFuture<Integer> a = answer;
+        if (a != null) {
+            a.complete(-1);
+        }
+    }
+
+    @Override
+    public List<SpellAbility> chooseSpellAbilityToPlay() {
+        if (mode == Mode.GOLDFISH) {
+            return Collections.emptyList();
+        }
+        Player p = getPlayer();
+        List<SpellAbility> candidates = new ArrayList<>();
+        CardCollectionView inPlay = p.getCardsIn(ZoneType.Battlefield);
+        CardCollectionView inHand = p.getCardsIn(ZoneType.Hand);
+        candidates.addAll(ComputerUtilAbility.getSpellAbilities(inPlay, p));
+        candidates.addAll(ComputerUtilAbility.getSpellAbilities(inHand, p));
+
+        List<SpellAbility> playable = new ArrayList<>();
+        for (SpellAbility sa : candidates) {
+            AiPlayDecision d = getAi().canPlaySa(sa);
+            if (d == AiPlayDecision.WillPlay || d == AiPlayDecision.MandatoryPlay) {
+                playable.add(sa);
+            }
+        }
+        if (playable.isEmpty()) {
+            return playable;
+        }
+        try {
+            answer = new CompletableFuture<>();
+            pending.put(new PendingDecision(playable, "priority"));
+            Integer idx = answer.get(DECISION_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            if (idx == null || idx < 0 || idx >= playable.size()) {
+                return Collections.emptyList();
+            }
+            return Collections.singletonList(playable.get(idx));
+        } catch (Exception e) {
+            return Collections.emptyList();
+        } finally {
+            answer = null;
+        }
+    }
+
+    @Override
+    public SpellAbility getAbilityToPlay(Card hostCard, List<SpellAbility> abilities,
+            ITriggerEvent triggerEvent) {
+        if (mode == Mode.GOLDFISH || abilities.isEmpty()) {
+            return null;
+        }
+        return super.getAbilityToPlay(hostCard, abilities, triggerEvent);
+    }
+}
diff --git a/forge-harness/src/main/proto/forge_env.proto b/forge-harness/src/main/proto/forge_env.proto
new file mode 100644
index 0000000000..bf8aaa5058
--- /dev/null
+++ b/forge-harness/src/main/proto/forge_env.proto
@@ -0,0 +1,144 @@
+// ForgeEnv gRPC contract — Layer 1 interface, frozen per project plan M1.
+// Both the Java harness server and the Python research client are generated from this file.
+//
+// Message conventions:
+//  - All ints are 0-indexed player slots unless noted.
+//  - Card identity: Forge card name (e.g. "Kiki-Jiki, Mirror Breaker").
+//  - Determinism: same (decks, seed, config) MUST yield byte-identical event streams.
+
+syntax = "proto3";
+package forgeenv;
+
+option java_package = "forge.harness.proto";
+option java_multiple_files = true;
+
+service ForgeEnv {
+  // Start a new game. Fails if a game is already active (stop it first).
+  rpc StartGame(StartRequest) returns (StartResponse);
+  // Block until the acting player has a decision pending, then return options.
+  rpc GetDecision(Empty) returns (DecisionRequest);
+  // Submit the acting player's choice; engine advances until next decision or game end.
+  rpc SubmitDecision(DecisionResponse) returns (StepResult);
+  // Full state snapshot of current game.
+  rpc GetState(Empty) returns (FullState);
+  // MCTS support: opaque state tokens (only valid within same game/session).
+  rpc Snapshot(Empty) returns (StateToken);
+  rpc Restore(StateToken) returns (Empty);
+  // Query game-over status without stepping.
+  rpc IsGameOver(Empty) returns (GameOver);
+  // Stop current game and release resources.
+  rpc StopGame(Empty) returns (Empty);
+  // Health / version.
+  rpc Ping(Empty) returns (Pong);
+}
+
+message Empty {}
+message Pong { string version = 1; bool game_active = 2; }
+
+message DeckSpec {
+  string name = 1;
+  string path = 2;          // path to .dck file
+}
+
+message StartRequest {
+  repeated DeckSpec decks = 1;       // 2 players for M1
+  int64 seed = 2;
+  repeated PlayerType player_types = 3;  // one per deck, same order
+  int32 max_turns = 4;               // 0 = unlimited; game ends as draw beyond this
+  int32 timeout_seconds = 5;         // per-game wall clock, 0 = engine default
+}
+
+enum PlayerType {
+  PLAYER_TYPE_UNSPECIFIED = 0;
+  PLAYER_TYPE_REMOTE = 1;      // decisions via GetDecision/SubmitDecision
+  PLAYER_TYPE_GOLDFISH = 2;    // dumb scripted: play lands, cast creatures, attack
+  PLAYER_TYPE_FORGE_AI = 3;    // built-in AI
+}
+
+message StartResponse {
+  int32 game_id = 1;
+  repeated int32 starting_life = 2;  // per player
+}
+
+message Option {
+  int32 id = 1;                     // stable within this DecisionRequest
+  string kind = 2;                  // "play_card" | "activate" | "choose" | "pass" | ...
+  string card_name = 3;             // empty if N/A
+  repeated string target_names = 4; // chosen targets if any
+  string description = 5;           // human-readable
+}
+
+message DecisionRequest {
+  int32 player = 1;                 // acting player slot
+  int32 turn = 2;
+  string phase = 3;                 // "Main1", "Combat", ...
+  repeated Option options = 4;
+  string prompt = 5;                // engine question, human-readable
+}
+
+message DecisionResponse {
+  int32 option_id = 1;              // must be one of the options from the last DecisionRequest
+}
+
+message GameEvent {
+  int32 turn = 1;
+  string phase = 2;
+  string type = 3;                  // "SpellResolved" | "PermanentEntered" | "TriggerFired"
+                                    // | "LifeChanged" | "TurnStarted" | "CardDrawn"
+                                    // | "PermanentLeftBattlefield" | "GameOver"
+  int32 player = 4;                 // acting/affected player
+  string card_name = 5;
+  string detail = 6;                // structured extra info, "key=value;key=value"
+}
+
+message StepResult {
+  repeated GameEvent events = 1;    // events generated by applying this decision
+  bool decision_pending = 2;        // another decision needed immediately
+  bool game_over = 3;
+}
+
+message Permanent {
+  int32 id = 1;
+  string card_name = 2;
+  int32 controller = 3;
+  int32 owner = 4;
+  bool tapped = 5;
+  bool attacking = 6;
+  bool blocking = 7;
+  map<string, int32> counters = 8;
+  repeated string attachments = 9;  // names of attached permanents (auras/equipment)
+  bool is_token = 10;
+  string type_line = 11;
+}
+
+message FullState {
+  int32 turn = 1;
+  string phase = 2;
+  int32 active_player = 3;
+  repeated int32 life = 4;
+  // Per-player zones: hand/library/graveyard/battlefield. Index = player slot.
+  repeated Zone hand = 5;
+  repeated Zone battlefield = 6;
+  repeated Zone graveyard = 7;
+  repeated Zone library = 8;        // top card first; counts only unless revealed
+  map<string, int32> mana_pools = 9; // key: player slot as string, value bytes keyed in detail
+  repeated GameEvent recent_events = 10;
+}
+
+message Zone {
+  repeated CardRef cards = 1;       // for battlefield use Permanent via battlefield zone only
+  repeated int32 permanents = 2;    // ids into FullState battlefield listing (battlefield zone only)
+}
+
+message CardRef {
+  string name = 1;
+  int32 count = 2;                  // for library stacks
+}
+
+message StateToken { bytes token = 1; }
+
+message GameOver {
+  bool over = 1;
+  int32 winner = 2;                 // -1 if draw
+  string reason = 3;
+}
